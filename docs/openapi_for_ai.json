{
  "title": "Pet Store API",
  "version": "1.0.0",
  "description": "A comprehensive API for managing a pet store, including pet creation, retrieval, updates, and file uploads.",
  "apis": [
    {
      "path": "/pets",
      "method": "GET",
      "summary": "List all pets",
      "description": "Retrieve a paginated list of pets with optional filtering.",
      "tags": [
        "Pets"
      ],
      "query_parameters": [
        {
          "name": "limit",
          "description": "Maximum number of pets to return",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 10,
            "minimum": 1,
            "maximum": 100
          }
        },
        {
          "name": "type",
          "description": "Filter pets by type",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "dog",
              "cat",
              "bird"
            ]
          }
        }
      ],
      "response_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier for the pet",
              "example": "123"
            },
            "name": {
              "type": "string",
              "description": "Name of the pet",
              "example": "Fluffy"
            },
            "type": {
              "type": "string",
              "description": "Type of the pet",
              "example": "dog",
              "enum": [
                "dog",
                "cat",
                "bird"
              ]
            },
            "age": {
              "type": "integer",
              "format": "int32",
              "description": "Age of the pet in years",
              "example": 3,
              "minimum": 0
            },
            "tags": {
              "type": "array",
              "description": "Tags associated with the pet",
              "example": [
                "friendly",
                "playful"
              ],
              "items": {
                "type": "string"
              }
            },
            "owner": {
              "type": "object",
              "description": "Owner of the pet",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "John Doe"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "example": "john.doe@example.com"
                }
              }
            }
          }
        }
      }
    },
